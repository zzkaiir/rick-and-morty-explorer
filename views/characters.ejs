
<%- include("partials/header") %>

<main class="container">
    <section class="page-heading">
        <h1>Explore Characters</h1>
        <p>Discover characters from the Rick and Morty universe.</p>
        <p class="results-count">
            Total characters: <strong><%= count %></strong>
        </p>
    </section>

<form action="/search" method="GET" class="search-form">
    <input
        type="text"
        name="q"
        placeholder="Search characters by name..."
        value="<%= searchQuery || '' %>"
        required
    >
    <button type="submit">Search</button>
</form>

<% if (searchQuery) { %>
    <p>Search results for: <strong><%= searchQuery %></strong></p>
<% } %>

<form action="/characters" method="GET" class="filter-form">

    <label for="status">Status:</label>
    <select name="status" id="status">
        <option value="">All statuses</option>
        <option value="alive" <%= status === "alive" ? "selected" : "" %>>Alive</option>
        <option value="dead" <%= status === "dead" ? "selected" : "" %>>Dead</option>
        <option value="unknown" <%= status === "unknown" ? "selected" : "" %>>Unknown</option>
    </select>

    <label for="gender">Gender:</label>
    <select name="gender" id="gender">
        <option value="">All genders</option>
        <option value="female" <%= gender === "female" ? "selected" : "" %>>Female</option>
        <option value="male" <%= gender === "male" ? "selected" : "" %>>Male</option>
        <option value="genderless" <%= gender === "genderless" ? "selected" : "" %>>Genderless</option>
        <option value="unknown" <%= gender === "unknown" ? "selected" : "" %>>Unknown</option>
    </select>

    <label for="sort">Sort by name:</label>
    <select name="sort" id="sort">
        <option value="asc" <%= sort === "asc" ? "selected" : "" %>>A–Z</option>
        <option value="desc" <%= sort === "desc" ? "selected" : "" %>>Z–A</option>
    </select>

    <button type="submit">Apply Filters</button>
</form>

<% if (characters.length === 0) { %>
    <p class="no-results">
        No characters found. Try another name.
    </p>
<% } else { %>
    <section class="character-grid">
        <% characters.forEach(character => { %>
            <article class="character-card">
                <img
                    src="<%= character.image %>"
                    alt="<%= character.name %>"
                    loading="lazy"
                    onerror="this.onerror=null; setTimeout(() => { this.src = this.src + '?retry=' + Date.now(); }, 1000)"
                >

                <div class="character-info">
                    <h2><%= character.name %></h2>

                    <p>
                        <strong>Status:</strong>
                        <%= character.status %>
                    </p>

                    <p>
                        <strong>Species:</strong>
                        <%= character.species %>
                    </p>

                    <p>
                        <strong>Gender:</strong>
                        <%= character.gender %>
                    </p>

                    <a href="/character/<%= character.id %>" class="details-link">
                        View Details
                    </a>
                </div>
            </article>
        <% }) %>
    </section>
<% } %>

    <% if (totalPages > 0) { %>
    <nav class="pagination">
        <% if (currentPage > 1) { %>
            <a href="/characters?status=<%= encodeURIComponent(status) %>&gender=<%= encodeURIComponent(gender) %>&sort=<%= encodeURIComponent(sort) %>&page=<%= currentPage - 1 %>">
                Previous
            </a>
        <% } %>

        <span>
            Page <%= currentPage %> of <%= totalPages %>
        </span>

        <% if (currentPage < totalPages) { %>
            <a href="/characters?status=<%= encodeURIComponent(status) %>&gender=<%= encodeURIComponent(gender) %>&sort=<%= encodeURIComponent(sort) %>&page=<%= currentPage + 1 %>">
                Next
            </a>
        <% } %>
    </nav>
<% } %>
</main>

<%- include("partials/footer") %>
