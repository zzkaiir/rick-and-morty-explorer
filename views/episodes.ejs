
<%- include("partials/header") %>

<main class="container">
    <section class="page-heading">
        <h1>Rick and Morty Episodes</h1>
        <p>Explore all episodes from the Rick and Morty universe</p>
    </section>

    <section class="episodes-grid">
        <% episodes.forEach(episode => { %>
            <a href="/episode/<%= episode.id %>" class="episode-card">
                <h2><%= episode.name %></h2>

                <p class="episode-code">
                    <%= episode.episode %>
                </p>

                <p>
                    <strong>Air date:</strong>
                    <%= episode.air_date %>
                </p>

                <p>
                    <strong>Created:</strong>
                    <%= episode.created.split("T")[0] %>
                </p>
            </a>
        <% }) %>
    </section>
</main>

<%- include("partials/footer") %>
