
<%- include("partials/header") %>

<main class="container">
    <section class="page-heading">
        <h1><%= location.name %></h1>
        <p>Location Details</p>
    </section>

    <section class="episode-details-card">
        <div class="episode-info">
            <div class="episode-info-item">
                <strong>Type</strong>
                <p><%= location.type %></p>
            </div>

            <div class="episode-info-item">
                <strong>Dimension</strong>
                <p><%= location.dimension %></p>
            </div>

            <div class="episode-info-item">
                <strong>Number of Residents</strong>
                <p><%= characters.length %></p>
            </div>
        </div>
        <h2>Residents</h2>

       <% if (characters.length === 0) { %>
        <p class="no-results">No known residents in this location.</p>
    <% } else { %>
        <section class="episode-characters">
            <% characters.forEach(character => { %>
                <a href="/character/<%= character.id %>" class="episode-character">
                    <img src="<%= character.image %>" alt="<%= character.name %>" loading="lazy" onerror="retryImage(this)">
                    <h3><%= character.name %></h3>
                </a>
            <% }) %>
        </section>
    <% } %>

    <a href="/locations" class="back-link">Back to Locations</a>
</section>
</main>

<%- include("partials/footer") %>
