
<%- include("partials/header") %>

<main class="container">
    <section class="page-heading">
        <h1><%= location.name %></h1>
        <p>Location Details</p>
    </section>

    <section class="episode-card">
        <p>
            <strong>Type:</strong>
            <%= location.type %>
        </p>

        <p>
            <strong>Dimension:</strong>
            <%= location.dimension %>
        </p>

        <p>
            <strong>Number of Residents:</strong>
            <%= characters.length %>
        </p>
    </section>

    <section class="page-heading">
        <h2>Residents</h2>
    </section>

    <section class="episodes-grid">
        <% characters.forEach(character => { %>
            <a href="/character/<%= character.id %>" class="episode-card">
                <img src="<%= character.image %>" alt="<%= character.name %>">

                <h3><%= character.name %></h3>

                <p>
                    <strong>Status:</strong>
                    <%= character.status %>
                </p>

                <p>
                    <strong>Species:</strong>
                    <%= character.species %>
                </p>
            </a>
        <% }) %>
    </section>

    <a href="/locations" class="back-link">Back to Locations</a>
</main>

<%- include("partials/footer") %>
